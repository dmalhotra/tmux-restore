# tmux-save — snapshot all tmux sessions (panes, cwd, scrollback, editor cmd).
#
# Atomic: everything is written into a staging dir and only complete files are
# swapped into place, so a crash mid-save never destroys the previous snapshot.
# Stale files (sessions/panes that went away) are pruned AFTER the new ones land.
#
# bash 3.2 compatible (macOS /bin/bash).  Fields are TAB-delimited so window
# names and paths containing spaces are preserved.

set -uo pipefail
shopt -s nullglob

tmux ls >/dev/null 2>&1 || exit 0          # no server / no sessions -> nothing to do

editors="vim|vi|nvim|emacs"
DEST_DIR="${HOME}/.tmux-sessions"
HOST="$(hostname -s)"
TAB=$'\t'
mkdir -p "$DEST_DIR"

# staging + manifest on the SAME filesystem as DEST_DIR (so final moves are atomic)
STAGE="$(mktemp -d "${DEST_DIR}/.stage.XXXXXX")"     || exit 1
MANIFEST="$(mktemp "${DEST_DIR}/.manifest.XXXXXX")"  || { rm -rf "$STAGE"; exit 1; }
trap 'rm -rf "$STAGE" "$MANIFEST"' EXIT

detect_editor_cmd() {
    local root_pid="$1" pid cmd
    get_descendants() {
        local parent="$1" child
        while read -r child; do
            [ -n "$child" ] || continue
            echo "$child"
            get_descendants "$child"
        done < <(ps -eo pid=,ppid= | awk -v p="$parent" '$2==p {print $1}')
    }
    for pid in "$root_pid" $(get_descendants "$root_pid"); do
        cmd="$(ps -p "$pid" -o command= 2>/dev/null)"
        if [[ "$cmd" =~ (^|[[:space:]])($editors)([[:space:]]|$) ]]; then
            printf '%s\n' "$cmd"
            return 0
        fi
    done
    return 1
}

while IFS= read -r session; do
    [ -n "$session" ] || continue
    panes_file="${HOST}-${session}-panes"
    : > "$STAGE/$panes_file"
    printf '%s\n' "$panes_file" >> "$MANIFEST"

    # record this session's panes (tab-delimited: session, window, wname, pane, layout)
    while IFS="$TAB" read -r p_session p_window p_pane p_layout p_wname; do
        [ "$p_session" = "$session" ] || continue
        printf '%s\t%s\t%s\t%s\t%s\n' \
            "$p_session" "$p_window" "$p_wname" "$p_pane" "$p_layout" >> "$STAGE/$panes_file"
    done < <(tmux list-panes -a -F \
        "#{session_name}${TAB}#{window_index}${TAB}#{pane_index}${TAB}#{window_layout}${TAB}#{window_name}")

    while IFS="$TAB" read -r s window wname pane layout; do
        [ -n "$s" ] || continue
        base="${HOST}-$s:$window.$pane"
        pid="$(tmux display-message -p -t "$s:$window.$pane" -F "#{pane_pid}" 2>/dev/null)"
        tmux display-message -p -t "$s:$window.$pane" -F "#{pane_current_path}" 2>/dev/null > "$STAGE/${base}-path"
        tmux capture-pane -t "$s:$window.$pane" -epS -100000 2>/dev/null > "$STAGE/$base"
        detect_editor_cmd "$pid" > "$STAGE/${base}-cmd" 2>/dev/null || true
        if command -v pstree >/dev/null 2>&1; then
            case "$(uname -s)" in
                Linux*)  pstree -a "$pid" >> "$STAGE/${base}-cmd" 2>/dev/null || true ;;
                Darwin*) pstree    "$pid" >> "$STAGE/${base}-cmd" 2>/dev/null || true ;;
            esac
        fi
        printf '%s\n%s\n%s\n' "$base" "${base}-path" "${base}-cmd" >> "$MANIFEST"
    done < "$STAGE/$panes_file"
done < <(tmux list-sessions -F "#{session_name}")

# swap staged files into place (same filesystem -> atomic per file)
for f in "$STAGE"/*; do
    mv -f "$f" "$DEST_DIR/$(basename "$f")"
done

# prune snapshot files for THIS host that are no longer current
for f in "$DEST_DIR/${HOST}-"*; do
    [ -e "$f" ] || continue
    grep -Fxq -- "$(basename "$f")" "$MANIFEST" || rm -f "$f"
done

echo "Saved"
