#!/bin/bash
# tmux-restore — recreate the sessions saved by tmux-save: windows, panes,
# layout, working directory, previous scrollback, and re-launch the editor
# that was running in each pane.
#
# bash 3.2 compatible.  Reads the TAB-delimited snapshot written by tmux-save.

set -uo pipefail
shopt -s nullglob

editors="vim|vi|nvim|emacs"
DEST_DIR="${HOME}/.tmux-sessions"
HOST="$(hostname -s)"
TAB=$'\t'

# real existence tests (has-session only checks the SESSION, not windows/panes)
window_exists() { tmux list-windows -t "=$1"   -F '#{window_index}' 2>/dev/null | grep -Fxq -- "$2"; }
pane_exists()   { tmux list-panes   -t "=$1:$2" -F '#{pane_index}'   2>/dev/null | grep -Fxq -- "$3"; }

panes_files=("$DEST_DIR/${HOST}-"*-panes)
[ "${#panes_files[@]}" -gt 0 ] || { echo "No saved sessions for $HOST."; exit 0; }

for pf in "${panes_files[@]}"; do
    [ -f "$pf" ] || continue
    session="$(head -n1 "$pf" | cut -d"$TAB" -f1)"
    [ -n "$session" ] || continue

    if tmux has-session -t "=$session" 2>/dev/null; then
        continue                          # already running -> leave it alone
    fi
    echo "Restoring session $session"

    # Pass 1: build the windows and panes
    while IFS="$TAB" read -r s window wname pane layout; do
        [ -n "$s" ] || continue
        if ! tmux has-session -t "=$s" 2>/dev/null; then
            tmux new-session -d -s "$s" -n "$wname"
            first="$(tmux list-windows -t "=$s" -F '#{window_index}' 2>/dev/null | head -n1)"
            if [ -n "$first" ] && [ "$first" != "$window" ]; then
                tmux move-window -d -s "=$s:$first" -t "=$s:$window" 2>/dev/null
            fi
        elif ! window_exists "$s" "$window"; then
            tmux new-window -d -t "=$s:$window" -n "$wname" 2>/dev/null
        fi
        if ! pane_exists "$s" "$window" "$pane"; then
            tmux split-window -d -t "=$s:$window" 2>/dev/null
        fi
    done < "$pf"

    # apply each window's saved layout once
    while IFS= read -r w; do
        [ -n "$w" ] || continue
        wlayout="$(awk -F"$TAB" -v win="$w" '$2==win{print $5; exit}' "$pf")"
        [ -n "$wlayout" ] && tmux select-layout -t "=$session:$w" "$wlayout" 2>/dev/null
    done < <(tmux list-windows -t "=$session" -F '#{window_index}' 2>/dev/null)

    # Pass 2: names, cwd, previous content, re-launch editor
    while IFS="$TAB" read -r s window wname pane layout; do
        [ -n "$s" ] || continue
        tmux rename-window -t "=$s:$window" "$wname" 2>/dev/null
        pane_exists "$s" "$window" "$pane" || continue
        base="$DEST_DIR/${HOST}-$s:$window.$pane"
        path=""
        [ -f "${base}-path" ] && path="$(cat "${base}-path")"
        qp="$(printf '%q' "${path:-$HOME}")"
        qb="$(printf '%q' "$base")"
        # suspend anything running, cd to the saved dir, redisplay previous content
        tmux send-keys -t "=$s:$window.$pane" C-z " cd $qp; cat $qb ${qb}-cmd 2>/dev/null" Enter
        if [ -f "${base}-cmd" ]; then
            cmd="$(head -n1 "${base}-cmd")"
            if [[ "$cmd" =~ (^|[[:space:]])($editors)([[:space:]]|$) ]]; then
                tmux send-keys -t "=$s:$window.$pane" "clear; ${cmd}" Enter
            fi
        fi
    done < "$pf"
done

tmux ls
